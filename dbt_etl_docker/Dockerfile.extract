FROM python:3.13

ARG DEBIAN_FRONTEND=noninteractive

RUN mkdir -p /home/etl

WORKDIR /home/etl

COPY ./requirements.txt requirements.txt

RUN pip install -r requirements.txt

COPY ./extract.py /home/etl/extract.py

ENV PG_HOST=

ENV PG_PORT=5432

ENV PG_USER=

ENV PG_PASSWD=

ENV PG_DB="postgres"

ENTRYPOINT [ "python3" ]

CMD [ "extract.py" ]
